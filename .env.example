# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/ecommerce

# JWT
# Replace all example secrets with long, random values in your local .env file.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_ACCESS_SECRET=replace_with_a_random_access_secret_at_least_30_characters
JWT_REFRESH_SECRET=replace_with_a_random_refresh_secret_at_least_30_characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Redis
REDIS_URL=redis://localhost:6379

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Ecommerce App <no-reply@example.com>"

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:5000/api/payments/paypal/return
PAYPAL_CANCEL_URL=http://localhost:5000/api/payments/paypal/cancel
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
